{
	"name": "website",
	"version": "0.0.1",
	"scripts": {
		"prebuild": "node scripts/clean.js",
		"clean": "node scripts/clean.js",
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"prepare": "svelte-kit sync"
	},
	"devDependencies": {
		"@fontsource/fira-mono": "^4.5.10",
		"@neoconfetti/svelte": "^1.0.0",
		"@sveltejs/adapter-auto": "^9.0.0",
		"@sveltejs/adapter-node": "^6.0.5",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/adapter-vercel": "^7.0.5",
		"@sveltejs/kit": "^3.4.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.2",
		"@types/cookie": "^0.5.1",
		"@types/node": "^24.19.2",
		"svelte": "^5.57.1",
		"svelte-check": "^4.0.0",
		"tslib": "^2.4.1",
		"typescript": "^6.0.0",
		"vite": "^8.0.12"
	},
	"type": "module",
	"imports": {
		"#lib/*.svelte": "./src/lib/*.svelte",
		"#lib/*": "./src/lib/*.ts"
	},
	"dependencies": {
		"@vercel/analytics": "2.3.0-canary",
		"posthog-js": "^1.369.1",
		"posthog-node": "^5.29.2",
		"svelte-french-toast": "^2.0.0-alpha.0"
	},
	"packageManager": "yarn@1.22.22+sha1.ac34549e6aa8e7ead463a7407e1c7390f61a6610",
	"allowScripts": {
		"core-js@3.49.0": true,
		"esbuild@0.28.2": true,
		"esbuild@0.25.12": true
	}
}
